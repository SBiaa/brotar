# Banco: Postgres no Neon (https://console.neon.tech → projeto → Connect)
# Troque o sslmode=require que o Neon entrega por sslmode=verify-full: o driver
# pg vai afrouxar o significado de "require" na v9 e deixar de validar o
# certificado do servidor. "verify-full" mantém a validação explicitamente.
# DATABASE_URL usa o host *com* "-pooler" — é a conexão que o app usa em cada request.
DATABASE_URL="postgresql://usuario:senha@ep-algo-pooler.sa-east-1.aws.neon.tech/brotar?sslmode=verify-full"

# DIRECT_URL é o mesmo host *sem* "-pooler". Só a CLI do Prisma usa, para migrar:
# o pooler não mantém a sessão necessária para aplicar DDL.
DIRECT_URL="postgresql://usuario:senha@ep-algo.sa-east-1.aws.neon.tech/brotar?sslmode=verify-full"

# Segredo do cookie de sessão (mínimo 32 caracteres).
# Gere o seu com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-32-caracteres"

# Fuso usado para decidir que dia é "hoje" ao marcar um hábito.
APP_TIMEZONE="America/Sao_Paulo"
